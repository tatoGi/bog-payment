{
  "name": "tatogi/bog-payment-laravel",
  "description": "Laravel package for BOG (Bank of Georgia) payment gateway integration with card management and payment tracking",
  "version": "1.1.0",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "laravel",
    "bog",
    "payment",
    "gateway",
    "bank-of-georgia",
    "payment-processing",
    "payment-integration"
  ],
  "authors": [
    {
      "name": "Tato",
      "email": "tato.laperashvili95@gmail.com"
    }
  ],
  "require": {
    "php": "^8.0|^8.1|^8.2|^8.3",
    "illuminate/support": "^9.0|^10.0|^11.0|^12.0",
    "illuminate/http": "^9.0|^10.0|^11.0|^12.0",
    "illuminate/database": "^9.0|^10.0|^11.0|^12.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6|^10.5|^11.0",
    "orchestra/testbench": "^7.0|^8.0|^9.0|^10.0"
  },
  "autoload": {
    "psr-4": {
      "Bog\\Payment\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Bog\\Payment\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Bog\\Payment\\BogPaymentServiceProvider"
      ]
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
